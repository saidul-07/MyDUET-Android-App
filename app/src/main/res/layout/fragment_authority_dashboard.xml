<?xml version="1.0" encoding="utf-8"?>
<android.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAuthHeader"
        style="@style/Widget.MyDUET.PremiumCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btnAuthLogout">

                <TextView
                    android:id="@+id/tvAuthName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CSE Programming Club"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvAuthRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Role: CLUB_AUTHORITY"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAuthLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Logout"
                android:textColor="?attr/colorError" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Subtitle Section -->
    <TextView
        android:id="@+id/tvMyEventsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardAuthHeader"
        android:layout_marginTop="20dp"
        android:text="My Events"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- RecyclerView for Managed Events -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAuthEvents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvMyEventsHeader"
        android:layout_marginTop="8dp"
        tools:listitem="@layout/item_event_card" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutAuthEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_below="@id/tvMyEventsHeader"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="?attr/colorOnSurfaceVariant"
            android:alpha="0.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No events published yet"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Click the '+' button below to create one."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Create Event Floating Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:contentDescription="Create Event"
        android:src="@android:drawable/ic_input_add"
        app:tint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary" />

</android.widget.RelativeLayout>
