<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_gradient">

    <!-- Abstract Background Circle 1 (Top Left) -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/bg_circle"
        android:alpha="0.04"
        android:translationX="-120dp"
        android:translationY="-120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Abstract Background Circle 2 (Bottom Right) -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/bg_circle"
        android:alpha="0.03"
        android:translationX="80dp"
        android:translationY="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Abstract Background Circle 3 (Center Left) -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_circle"
        android:alpha="0.03"
        android:translationX="-60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Central Content Container -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Official DUET Logo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logo_container"
            android:layout_width="130dp"
            android:layout_height="130dp"
            app:cardCornerRadius="36dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:src="@drawable/duet_official_logo"
                android:contentDescription="DUET Official Logo" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Animated Loading Indicator (Dots) -->
        <LinearLayout
            android:id="@+id/loading_dots_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="28dp">

            <View
                android:id="@+id/dot1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle"
                android:alpha="0.4"
                android:scaleX="1.0"
                android:scaleY="1.0" />

            <View
                android:id="@+id/dot2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle"
                android:alpha="0.4"
                android:scaleX="1.0"
                android:scaleY="1.0" />

            <View
                android:id="@+id/dot3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle"
                android:alpha="0.4"
                android:scaleX="1.0"
                android:scaleY="1.0" />
        </LinearLayout>

        <!-- 3. Title: MyDUET -->
        <TextView
            android:id="@+id/app_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MyDUET"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <!-- 4. Subtitle: Dept. of CSE -->
        <TextView
            android:id="@+id/dept_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dept. of CSE"
            android:textColor="#E3F2FD"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <!-- 5. Footer: Dhaka University of Engineering & Technology -->
        <TextView
            android:id="@+id/university_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Dhaka University of Engineering &amp; Technology"
            android:textColor="#BBDEFB"
            android:textSize="15sp"
            android:gravity="center"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- Version Info (at bottom position) -->
    <TextView
        android:id="@+id/version_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Version 26.0.0"
        android:textColor="#BBDEFB"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>