<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MyDUET.PremiumCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground">

        <!-- Department Emoji Frame -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconContainer"
            style="@style/Widget.MyDUET.QuickServiceIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/primary_light">

            <TextView
                android:id="@+id/tvDeptEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="💻"
                android:textSize="22sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Department Abbreviation Name -->
        <TextView
            android:id="@+id/tvDeptCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="CSE"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Department Full Name -->
        <TextView
            android:id="@+id/tvDeptFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Computer Science"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:ellipsize="end"
            android:maxLines="2"
            android:lineSpacingMultiplier="1.1" />

        <!-- Teacher Count -->
        <TextView
            android:id="@+id/tvTeacherCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="28 Teachers"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Dynamic Action Link -->
        <TextView
            android:id="@+id/tvViewFacultyLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="View Faculty →"
            android:textColor="@color/primary_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
