<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Blue Gradient Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#42A5F5"
                android:startColor="#1565C0"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Glass Overlay -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" /> <!-- ~18% Opacity -->
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" /> <!-- ~35% Opacity -->
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>